<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rumb_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="6dp"
    android:background="@drawable/rumb_widget_glass_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rumb_tile_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Wi-Fi"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_wifi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Wi-Fi"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_internet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Internet"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_data" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Internet"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_bluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Bluetooth"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_bluetooth" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bluetooth"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_torch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
            android:id="@+id/rumb_tile_torch_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Torch"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_torch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Torch"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rumb_tile_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Volume"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_volume" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Volume"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Display"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_brightness" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Display"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Battery"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_battery" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Battery"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rumb_tile_hidden"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rumb_tile_bg"
                android:contentDescription="Hidden"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rumb_ic_hidden_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hidden"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="6" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
